# ============================================================
# EdgeOne Makers · openai-agent-starter-python 环境变量
# ------------------------------------------------------------
# 用法：cp .env.example .env  然后填入自己的值
# 本文件只放占位符，禁止写入真实 Key / Token。
# 线上部署时这些变量要在 Makers 控制台的「项目设置 → 环境变量」里配，
# 不会从仓库读取 .env。
# ============================================================

# ---- LLM 网关（必填）----

# 模型网关 API Key。可以是 EdgeOne Makers Models 的 Key，
# 也可以是任意 OpenAI 兼容服务商的 Key。
# 获取：Makers 控制台 → Models → API Key
AI_GATEWAY_API_KEY=

# 网关 Base URL。使用 Makers Models 时固定填下面这个值。
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# ---- 模型（可选）----

# 模型 ID。留空时代码默认使用 @makers/deepseek-v4-flash（内置免费模型，
# 有调用量限制，适合验证；生产建议绑定自有厂商 Key）。
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ---- 地图（必填，出行决策工具使用）----

# 高德开放平台「Web 服务」类型 Key（不是 Web端 JS Key）。
# 获取：https://console.amap.com/dev/key/app — 新建应用 → 添加 Key → 服务平台选「Web服务」
# 用于 resolve_location / search_nearby / search_brand_stores / walking_route。
AMAP_API_KEY=
